<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>galbot_s1_description</name>
  <version>0.1.0</version>
  <description>
    Galbot S1 robot description (xacro + COLLADA/STL meshes) for ROS 1 and ROS 2,
    converted from GalaxyGeneralRobotics/galbot_s1_description.
  </description>
  <maintainer email="mamoru1126@users.noreply.github.com">mamoru1126</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/mamoru1126/galbot_s1_gazebo</url>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rviz</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">rviz2</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">launch_ros</exec_depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
